# ==============================================================================
# DATAEKO × meshIQ Partner Dashboard — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env (do NOT commit .env to version control).
# 2. In production, all variables marked [MANDATORY IN PRODUCTION] must be set.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: development, test, production
ENVIRONMENT=development

# Enable/disable debug mode (MUST be False in production)
# [MANDATORY IN PRODUCTION: False]
DEBUG=True

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Development / Local: sqlite+aiosqlite:///./meshiq_partner.db
# Production: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
# [MANDATORY IN PRODUCTION: Must be PostgreSQL connection string]
DATABASE_URL=sqlite+aiosqlite:///./meshiq_partner.db

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# 256-bit signing key for JWT tokens (Generate with: openssl rand -hex 32)
# [MANDATORY IN PRODUCTION: Must be unique and at least 32 characters]
SECRET_KEY=dev-insecure-secret-key-change-in-production-dataeko-meshiq-2026

# JWT Algorithm (default: HS256)
ALGORITHM=HS256

# Access token expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Transport cookies over HTTPS only (MUST be True in production)
# [MANDATORY IN PRODUCTION: True]
SECURE_COOKIES=False

# Cookie SameSite attribute ('lax' for local dev cross-origin, 'strict' in production)
# [MANDATORY IN PRODUCTION: strict]
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 4. CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list or JSON array of trusted frontend origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# ------------------------------------------------------------------------------
# 5. FRONTEND RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Base API URL used by frontend client to connect to FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
